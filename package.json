{
  "name": "lol-matchup-viewer",
  "version": "0.1.2",
  "description": "Instant LoL lane matchup ranges and key cooldowns.",
  "main": "dist-electron/main/main.js",
  "author": "LoL Matchup Viewer contributors",
  "license": "MIT",
  "scripts": {
    "dev": "tsc -p tsconfig.main.json && concurrently -k \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.main.json && vite build && electron-builder",
    "build:dir": "npm run clean && tsc -p tsconfig.main.json && vite build && electron-builder --dir",
    "clean": "rimraf dist dist-electron release"
  },
  "build": {
    "appId": "com.lolmatchup.viewer",
    "productName": "LoL Matchup Viewer",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "extraResources": [{ "from": "data", "to": "data" }],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "wait-on": "^8.0.1"
  }
}
